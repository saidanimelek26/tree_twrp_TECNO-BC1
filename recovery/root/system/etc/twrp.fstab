/system        ext4    /dev/block/mapper/system                              flags=display="System";backup=1
/vendor        ext4    /dev/block/mapper/vendor                              flags=display="Vendor";backup=1
/product       ext4    /dev/block/mapper/product                             flags=display="Product";backup=1
/system_image  emmc    /dev/block/mapper/system                              flags=display="System Image";backup=1;flashimg=1
/vendor_image  emmc    /dev/block/mapper/vendor                              flags=display="Vendor Image";backup=1;flashimg=1
/product_image emmc    /dev/block/mapper/product                             flags=display="Product Image";backup=1;flashimg=1
/data          f2fs    /dev/block/platform/bootdevice/by-name/userdata        flags=display="Data";backup=1;wipeingui;fileencryption=adiantum:adiantum
/cache         ext4    /dev/block/platform/bootdevice/by-name/cache           flags=display="Cache";backup=1;wipeingui;wipeduringfactoryreset
/metadata      ext4    /dev/block/platform/bootdevice/by-name/md_udc          flags=display="Metadata";backup=1
/metadata_raw  emmc    /dev/block/platform/bootdevice/by-name/metadata        flags=display="Metadata Image";backup=1
/persist       ext4    /dev/block/platform/bootdevice/by-name/persist         flags=display="Persist";backup=1;mounttodecrypt
/nvdata        ext4    /dev/block/platform/bootdevice/by-name/nvdata          flags=display="Nvdata";backup=1
/protect_f     ext4    /dev/block/platform/bootdevice/by-name/protect1        flags=display="Protect_f";backup=1
/protect_s     ext4    /dev/block/platform/bootdevice/by-name/protect2        flags=display="Protect_s";backup=1
/boot          emmc    /dev/block/platform/bootdevice/by-name/boot            flags=display="Boot";backup=1;flashimg=1
/recovery      emmc    /dev/block/platform/bootdevice/by-name/recovery        flags=display="Recovery";backup=1;flashimg=1
/dtbo          emmc    /dev/block/platform/bootdevice/by-name/dtbo            flags=display="Dtbo";backup=1;flashimg=1
/vbmeta        emmc    /dev/block/platform/bootdevice/by-name/vbmeta          flags=display="VBMeta";backup=1;flashimg=1
/vbmeta_system emmc    /dev/block/platform/bootdevice/by-name/vbmeta_system   flags=display="VBMeta System";backup=1;flashimg=1
/vbmeta_vendor emmc    /dev/block/platform/bootdevice/by-name/vbmeta_vendor   flags=display="VBMeta Vendor";backup=1;flashimg=1
/logo          emmc    /dev/block/platform/bootdevice/by-name/logo            flags=display="Logo";backup=1;flashimg=1
/nvram         emmc    /dev/block/platform/bootdevice/by-name/nvram           flags=display="Nvram";backup=1
/proinfo       emmc    /dev/block/platform/bootdevice/by-name/proinfo         flags=display="Proinfo";backup=1
/seccfg        emmc    /dev/block/platform/bootdevice/by-name/seccfg          flags=display="Seccfg";backup=1
/secro         emmc    /dev/block/platform/bootdevice/by-name/secro           flags=display="Secro";backup=1
/tee1          emmc    /dev/block/platform/bootdevice/by-name/tee1            flags=display="Tee1";backup=1;flashimg=1
/tee2          emmc    /dev/block/platform/bootdevice/by-name/tee2            flags=display="Tee2";backup=1;flashimg=1
/keystore      emmc    /dev/block/platform/bootdevice/by-name/keystore        flags=display="Keystore";backup=1
/oemkeystore   emmc    /dev/block/platform/bootdevice/by-name/oemkeystore     flags=display="Oemkeystore";backup=1
/expdb         emmc    /dev/block/platform/bootdevice/by-name/expdb           flags=display="Expdb";backup=1
/frp           emmc    /dev/block/platform/bootdevice/by-name/frp             flags=display="Frp";backup=1
/misc          emmc    /dev/block/platform/bootdevice/by-name/para            flags=display="Misc";backup=1
/bootloader    emmc    /dev/block/platform/bootdevice/by-name/lk              flags=display="Bootloader";backup=1
/bootloader2   emmc    /dev/block/platform/bootdevice/by-name/lk2             flags=display="Bootloader2";backup=1
/external_sd   auto    /dev/block/mmcblk1p1     /dev/block/mmcblk1            flags=display="MicroSD";storage;wipeingui;removable;backup=0
/usbotg        auto    /dev/block/sda1          /dev/block/sda                flags=display="USB OTG";storage;wipeingui;removable;backup=0
